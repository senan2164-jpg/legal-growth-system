# URL publique du site (canonical, sitemap, Open Graph, Schema.org)
NEXT_PUBLIC_SITE_URL=

# Adresse de contact affichée publiquement (facultatif : laissée vide, aucune adresse n'est affichée)
NEXT_PUBLIC_CONTACT_EMAIL=

# URL de l'application web Google Apps Script (se termine par /exec) — voir README
GOOGLE_SCRIPT_URL=

# Secret partagé entre le site et le script Apps Script (même valeur des deux côtés)
LEAD_SHARED_SECRET=
